DB_USERNAME=postgres
DB_PASSWORD=your_postgresql_password_here
# Generate a unique, high-entropy value (at least 32 bytes) and keep it out of source control.
JWT_SECRET=replace_with_a_unique_random_32_byte_or_longer_secret
JWT_EXPIRATION_MS=3600000

# Gmail SMTP credentials for sending system emails (account verification,
# appointment/ban notifications, etc.). Use a Gmail App Password, not the
# normal account password. Never commit real values; keep them in .env only.
MAIL_USERNAME=your_gmail_address_here
MAIL_PASSWORD=your_gmail_app_password_here
